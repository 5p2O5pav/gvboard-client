{
  // 配置格式版本。当前程序使用 1。
  "schema_version": 1,

  // 配置的唯一 ID，用于本地缓存键。
  // 更换一套独立配置时建议使用不同的 ID。
  "oss_id": "my_client_production",

  // 网站或主站地址。
  "website_url": "https://www.example.com",

  "brand": {
    // 完整品牌名称，用于空间足够的页面。
    "name": "My Client",

    // 短品牌名称，用于按钮、标题等空间较小的位置。
    "short_name": "MyClient",

    // 在线 Logo 地址。没有在线 Logo 时使用空字符串。
    "logo_url": "https://www.example.com/assets/logo.png"
  },

  // API 列表。至少需要一个有效 API，否则配置校验不会通过。
  "apis": [
    {
      // API 节点的唯一标识。
      "id": "primary",

      // API 根地址。请使用 HTTPS，并根据你的服务端实际路由填写。
      "base_url": "https://api.example.com",

      // 节点优先级。数值越小越优先。
      "priority": 1
    },
    {
      // 可选的备用 API。主 API 不可用时可由业务代码选择备用节点。
      "id": "backup",
      "base_url": "https://backup-api.example.com",
      "priority": 2
    }
  ],

  "customer_service": {
    // 客服类型。当前常用值为 web，表示打开网页客服。
    "type": "web",

    // 客服页面地址。
    "url": "https://www.example.com/support"
  },

  "offline": {
    // 是否允许在远程 OSS 暂时不可用时使用本地缓存。
    "enabled": true,

    // 离线缓存最多使用多少天。
    "max_days": 7
  },

  "client_update": {
    // 最新版本号。留空表示不显示版本更新提示。
    "latest_version": "",

    // 最低支持版本号。留空表示不强制更新。
    "minimum_version": "",

    // 更新包或下载页面地址。
    "update_url": "",

    // 更新说明，可填写纯文本或由客户端支持的文本内容。
    "release_notes": ""
  },

  "network": {
    // 下载远程 OSS 的超时时间，单位为秒。
    "oss_timeout_seconds": 8,

    // 请求业务 API 的超时时间，单位为秒。
    "api_timeout_seconds": 10,

    // API 请求失败后的重试次数。
    "api_retry_count": 1
  }
}
